{
  "name": "minecraft-ai-house-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "compatibility": "node compatibility/probe.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "dev": "tsx src/server/index.ts",
    "build": "tsc && vite build --config dashboard/vite.config.ts",
    "start": "node dist/src/server/index.js"
  },
  "dependencies": {
    "express": "5.2.1",
    "mineflayer": "4.39.0",
    "mineflayer-pathfinder": "2.4.5",
    "rcon-client": "4.2.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vec3": "0.1.10",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
